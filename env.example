# Database Configuration
MONGODB_URI=mongodb://localhost:27017/apartment_management

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration (for image uploads)
